{
  "expo": {
    "name": "دستیار زبان اشاره",
    "slug": "dastyar-offline",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "dastyar",
    "assetBundlePatterns": [
      "assets/models/*"
    ],
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "دستیار برای تشخیص زبان اشاره به دوربین نیاز دارد."
        }
      ]
    ],
    "android": {
      "package": "com.dastyar.signlanguage",
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "enableProguardInReleaseBuilds": true,
      "enableShrinkResourcesInReleaseBuilds": true
    },
    "extra": {
      "eas": {
        "projectId": "2f084a56-5a55-4700-9ffc-519579932c8a"
      }
    },
    "owner": "lorduniblesseds-team"
  }
}
